{
  "name": "coursera-courses-scraper",
  "version": "1.1.0",
  "description": "Authorized Coursera catalog analysis with US learning reports and labeled synthetic previews; no live collection.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "npm run build && node --test dist/*.test.js",
    "lint": "tsc --noEmit",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "apify": "3.7.2"
  },
  "devDependencies": {
    "@apify/tsconfig": "^0.1.1",
    "@types/node": "^20.19.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "basic-ftp": "6.2.3"
  }
}
