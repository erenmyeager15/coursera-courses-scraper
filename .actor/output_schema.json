{
  "actorOutputSchemaVersion": 1,
  "title": "Course Comparison & US Skills Reports",
  "description": "Licensed-import analysis or clearly labeled invented previews. No live source collection or rights verification.",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "title": "Run status and exact delivery limits",
      "template": "{{links.apiDefaultKeyValueStoreUrl}}/records/RUN_STATUS"
    },
    "report": {
      "type": "string",
      "title": "Course report — import or labeled synthetic preview",
      "template": "{{links.apiDefaultKeyValueStoreUrl}}/records/COURSE_REPORT"
    },
    "comparison": {
      "type": "string",
      "title": "Formula-safe course comparison CSV",
      "template": "{{links.apiDefaultKeyValueStoreUrl}}/records/COURSE_COMPARISON.csv"
    },
    "skillGaps": {
      "type": "string",
      "title": "Exact supplied skill-tag gap matrix",
      "template": "{{links.apiDefaultKeyValueStoreUrl}}/records/SKILL_GAPS.csv"
    },
    "changes": {
      "type": "string",
      "title": "Matching supplied changes — no live refresh",
      "template": "{{links.apiDefaultKeyValueStoreUrl}}/records/CHANGES.csv"
    },
    "quality": {
      "type": "string",
      "title": "Missing-field and context warnings",
      "template": "{{links.apiDefaultKeyValueStoreUrl}}/records/QUALITY.csv"
    },
    "markdown": {
      "type": "string",
      "title": "Readable research report",
      "template": "{{links.apiDefaultKeyValueStoreUrl}}/records/REPORT.md"
    },
    "results": {
      "type": "string",
      "title": "Saved imported course analyses — demos have no dataset rows",
      "template": "{{links.apiDefaultDatasetUrl}}/items"
    }
  }
}
